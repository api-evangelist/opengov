        {
          "id": "09487ea5-5a77-46f6-b702-9fdab0a6ef44",
          "name": "Sync invoice allocations",
          "request": {
            "name": "Sync invoice allocations",
            "description": {
              "content": "Processes delta-based invoice allocation updates. Accepts invoice header, line items (with quantities), and splits (with amounts). Upserts by invoiceLineId (allocations) and invoiceLineDistributionId (splits). Applies deltas to running totals and triggers financial recompute. Idempotent: replayed requests (same idempotencyKey) return 200; new requests return 202.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "po",
                "entities",
                ":entityId",
                "invoice-allocations"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "04eb277c-f9cd-42b0-9610-0f068f6aaea1",
                  "key": "entityId",
                  "description": "(Required) The UUID of the Platform entity"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idempotencyKey\": \"<uuid>\",\n  \"invoices\": [\n    {\n      \"invoiceId\": \"<uuid>\",\n      \"lineItems\": [\n        {\n          \"invoiceLineId\": \"<uuid>\",\n          \"poPurchaseOrderId\": \"<number>\",\n          \"poLineItemId\": \"<number>\",\n          \"deltaMatchedQuantity\": \"<string>\",\n          \"deltaInvoicedQuantity\": \"<string>\",\n          \"lineItemSplits\": [\n            {\n              \"invoiceLineDistributionId\": \"<number>\",\n              \"poLineItemSplitId\": \"<number>\",\n              \"deltaMatchedAmount\": \"<string>\",\n              \"deltaInvoicedAmount\": \"<string>\",\n              \"deltaPaidAmount\": \"<string>\",\n              \"deltaEncLiquidatedAccrualAmount\": \"<string>\"\n            },\n            {\n              \"invoiceLineDistributionId\": \"<number>\",\n              \"poLineItemSplitId\": \"<number>\",\n              \"deltaMatchedAmount\": \"<string>\",\n              \"deltaInvoicedAmount\": \"<string>\",\n              \"deltaPaidAmount\": \"<string>\",\n              \"deltaEncLiquidatedAccrualAmount\": \"<string>\"\n            }\n          ]\n        }\n      ],\n      \"invoiceNumber\": \"<string>\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
