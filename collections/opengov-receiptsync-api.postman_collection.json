        {
          "id": "b52b5953-8732-4f9e-bf50-d415a088006a",
          "name": "Sync receipt allocations",
          "request": {
            "name": "Sync receipt allocations",
            "description": {
              "content": "Processes receipt allocation updates using full-replacement semantics. Accepts receipt header and line items with accepted quantities. Replaces all previous allocations for the receipt and triggers accepted quantity recompute. Idempotent: replayed requests (same idempotencyKey) return 200; new requests return 202.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "po",
                "entities",
                ":entityId",
                "receipt-allocations"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "04eb277c-f9cd-42b0-9610-0f068f6aaea1",
                  "key": "entityId",
                  "description": "(Required) The UUID of the Platform entity"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idempotencyKey\": \"<uuid>\",\n  \"receipts\": [\n    {\n      \"receiptId\": \"<number>\",\n      \"receiptNumber\": \"<string>\",\n      \"lineItems\": [\n        {\n          \"receiptLineItemId\": \"<number>\",\n          \"poPurchaseOrderId\": \"<number>\",\n          \"poLineItemId\": \"<number>\",\n          \"acceptedQuantity\": \"<string>\"\n        }\n      ]\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
