{
  "opencollection": "1.0.0",
  "info": {
    "name": "Permitting & Licensing Departments API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Departments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List departments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.plce.opengov.com/plce/v2/:community/departments"
          },
          "docs": "Retrieve a list of departments that match the specified filters.\n### Permissions Required\n`System Config Read`"
        },
        {
          "info": {
            "name": "Get department",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.plce.opengov.com/plce/v2/:community/departments/:departmentID",
            "params": [
              {
                "name": "departmentID",
                "value": "",
                "type": "path",
                "description": "ID of the department"
              }
            ]
          },
          "docs": "Retrieve a department by ID.\n### Permissions Required\n`System Config Read`"
        }
      ]
    }
  ],
  "bundled": true
}