{
  "opencollection": "1.0.0",
  "info": {
    "name": "Permitting & Licensing Record Workflow Step Comments API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Record Workflow Step Comments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List comments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.plce.opengov.com/plce/v2/:community/records/:recordID/workflow-steps/:stepID/comments"
          },
          "docs": "List comments on a record workflow step.\n### Permissions Required\n`Comment Read`"
        },
        {
          "info": {
            "name": "Add a comment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.plce.opengov.com/plce/v2/:community/records/:recordID/workflow-steps/:stepID/comments",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add a comment to a record workflow step.\n### Permissions Required\n`Comment Write`"
        },
        {
          "info": {
            "name": "Retrieve a step comment",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.plce.opengov.com/plce/v2/:community/records/:recordID/workflow-steps/:stepID/comments/:commentID",
            "params": [
              {
                "name": "commentID",
                "value": "",
                "type": "path",
                "description": "ID of a comment on a workflow step of a record"
              }
            ]
          },
          "docs": "Retrieve a step comment.\n### Permissions Required\n`Comment Read`"
        },
        {
          "info": {
            "name": "Remove a step comment",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.plce.opengov.com/plce/v2/:community/records/:recordID/workflow-steps/:stepID/comments/:commentID",
            "params": [
              {
                "name": "commentID",
                "value": "",
                "type": "path",
                "description": "ID of a comment on a workflow step of a record"
              }
            ]
          },
          "docs": "Remove a step comment.\n### Permissions Required\n`Comment Write`"
        }
      ]
    }
  ],
  "bundled": true
}