{
  "opencollection": "1.0.0",
  "info": {
    "name": "Vendor Management Entity Users API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "entity-users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "entity-users.getEntityUsers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.vendor.opengov.com/api/v1/entities/:entityId/users",
            "headers": [
              {
                "name": "Authorization",
                "value": "Bearer <your-jwt-token>"
              }
            ],
            "params": [
              {
                "name": "entityId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          }
        }
      ]
    }
  ],
  "bundled": true
}