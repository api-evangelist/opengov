{
  "opencollection": "1.0.0",
  "info": {
    "name": "OpenGov Purchase Order Activity API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "activity",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List the activity feed for a Purchase Order",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-purchase-order.procurement.opengov.com/api/v1/po/entities/:entityId/purchase-orders/:poId/activity",
            "params": [
              {
                "name": "entityId",
                "value": "",
                "type": "path",
                "description": "The UUID of the Platform entity"
              },
              {
                "name": "poId",
                "value": "",
                "type": "path"
              },
              {
                "name": "entryTypes",
                "value": "",
                "type": "query"
              },
              {
                "name": "visibilityScope",
                "value": "",
                "type": "query"
              },
              {
                "name": "scope",
                "value": "",
                "type": "query"
              },
              {
                "name": "lineItemIds",
                "value": "",
                "type": "query"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query"
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query"
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query"
              },
              {
                "name": "search",
                "value": "",
                "type": "query"
              },
              {
                "name": "changeOrderId",
                "value": "",
                "type": "query",
                "description": "a string to be decoded into a number"
              }
            ]
          },
          "docs": "Returns a paginated, filtered, sortable chronological feed of comments and attachments from po_activity_logs. Supports cursor-based infinite scroll."
        }
      ]
    }
  ],
  "bundled": true
}