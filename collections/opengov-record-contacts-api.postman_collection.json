      "name": "Record Contacts",
      "description": {
        "content": "A Record can have one **Applicant** and up to 99 **Guests**.\n\nThe Applicant is the public user who submitted a Record. The Applicant or any employee user can add Guests to a Record.\n\n",
        "type": "text/plain"
      },
