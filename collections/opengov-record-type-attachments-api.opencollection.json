{
  "opencollection": "1.0.0",
  "info": {
    "name": "Permitting & Licensing Record Type Attachments API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Record Type Attachments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List attachment templates for a record type",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.plce.opengov.com/plce/v2/:community/record-types/:recordTypeID/attachments",
            "params": [
              {
                "name": "recordTypeID",
                "value": "",
                "type": "path",
                "description": "ID of the record type"
              }
            ]
          },
          "docs": "List attachment templates for a record type.\n### Permissions Required\n`Record Type Read`"
        },
        {
          "info": {
            "name": "Get attachment template",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.plce.opengov.com/plce/v2/:community/record-types/attachments/:recordTypeAttachmentID",
            "params": [
              {
                "name": "recordTypeAttachmentID",
                "value": "",
                "type": "path",
                "description": "ID of the record type attachment"
              }
            ]
          },
          "docs": "Retrieve an attachment template for a record type by ID.\n### Permissions Required\n`Record Type Read`"
        }
      ]
    }
  ],
  "bundled": true
}