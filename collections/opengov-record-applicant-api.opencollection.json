{
  "opencollection": "1.0.0",
  "info": {
    "name": "Permitting & Licensing Record Applicant API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Record Applicant",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get applicant",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.plce.opengov.com/plce/v2/:community/records/:recordID/applicant"
          },
          "docs": "Retrieve the applicant associated with a record.\n\n### Permissions Required\n`Record Read`"
        },
        {
          "info": {
            "name": "Update applicant",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.plce.opengov.com/plce/v2/:community/records/:recordID/applicant",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add or change the applicant associated with a record.\n### Permissions Required\n`Record Write`"
        },
        {
          "info": {
            "name": "Remove applicant",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.plce.opengov.com/plce/v2/:community/records/:recordID/applicant"
          },
          "docs": "Remove the applicant from a record.\n### Permissions Required\n`Record Write`"
        }
      ]
    }
  ],
  "bundled": true
}