{
  "opencollection": "1.0.0",
  "info": {
    "name": "Permitting & Licensing Record Type Form API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Record Type Form",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get form fields",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.plce.opengov.com/plce/v2/:community/record-types/:recordTypeID/form"
          },
          "docs": "Retrieve the form fields for the specified record type.\n### Permissions Required\n`Record Type Read`"
        }
      ]
    }
  ],
  "bundled": true
}