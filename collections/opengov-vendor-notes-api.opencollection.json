            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.vendor.opengov.com/api/v1/entities/:entityId/vendors/:vendorKey/notes",
            "headers": [
              {
                "name": "Authorization",
                "value": "Bearer <your-jwt-token>"
              }
            ],
            "params": [
              {
                "name": "entityId",
                "value": "",
                "type": "path"
              },
              {
                "name": "vendorKey",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          }
        },
        {
          "info": {
            "name": "vendor-notes.createVendorNote",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.vendor.opengov.com/api/v1/entities/:entityId/vendors/:vendorKey/notes",
            "headers": [
              {
                "name": "Authorization",
                "value": "Bearer <your-jwt-token>"
              }
            ],
            "params": [
              {
                "name": "entityId",
                "value": "",
                "type": "path"
              },
              {
                "name": "vendorKey",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          }
        },
        {
          "info": {
            "name": "vendor-notes.updateVendorNote",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.vendor.opengov.com/api/v1/entities/:entityId/vendors/:vendorKey/notes/:noteId",
            "headers": [
              {
                "name": "Authorization",
                "value": "Bearer <your-jwt-token>"
              }
            ],
            "params": [
              {
                "name": "entityId",
                "value": "",
                "type": "path"
              },
              {
                "name": "vendorKey",
                "value": "",
                "type": "path"
              },
              {
                "name": "noteId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          }
        },
        {
          "info": {
            "name": "vendor-notes.deleteVendorNote",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.vendor.opengov.com/api/v1/entities/:entityId/vendors/:vendorKey/notes/:noteId",
            "headers": [
              {
                "name": "Authorization",
                "value": "Bearer <your-jwt-token>"
              }
            ],
            "params": [
              {
                "name": "entityId",
                "value": "",
                "type": "path"
              },
              {
                "name": "vendorKey",
                "value": "",
                "type": "path"
              },
              {
                "name": "noteId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          }
        }
      ]
    }
  ],
  "bundled": true
}