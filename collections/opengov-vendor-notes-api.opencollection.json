{
  "opencollection": "1.0.0",
  "info": {
    "name": "Vendor Management Vendor Notes API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "vendor-notes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
