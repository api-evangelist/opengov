{
  "opencollection": "1.0.0",
  "info": {
    "name": "Permitting Licensing & Code Enforcement Record Form API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Record Form",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List record form fields",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.plce.opengov.com/plce/v1/:community/records/:recordID/details",
            "params": [
              {
                "name": "community",
                "value": "",
                "type": "path",
                "description": "Name of the community"
              },
              {
                "name": "recordID",
                "value": "",
                "type": "path",
                "description": "ID of the record"
              }
            ]
          },
          "docs": "List record form fields"
        }
      ]
    }
  ],
  "bundled": true
}