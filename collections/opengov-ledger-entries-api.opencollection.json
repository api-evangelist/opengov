{
  "opencollection": "1.0.0",
  "info": {
    "name": "Permitting & Licensing Ledger Entries API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Ledger Entries",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List ledger entries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.plce.opengov.com/plce/v2/:community/ledger-entries",
            "params": [
              {
                "name": "filter[transactionDate]",
                "value": "",
                "type": "query",
                "description": "Filter by transaction date, either an exact date/date-time or a range.\n\nA bare value (e.g. filter[transactionDate]=2026-06-19) matches that whole day when a date-only\nvalue is given, or that exact instant when a full ISO-8601 date-time is given.\n\nSupports filter[transactionDate][gte] and/or filter[transactionDate][lte] (ISO-8601 dates or date-times)\nfor a range. Range is inclusive of both bounds. If only one bound is provided, filter on that bound only.\n\nIf gte > lte, return 400 invalid_parameter.\n"
              },
              {
                "name": "filter[transactionType]",
                "value": "",
                "type": "query",
                "description": "Filter by transaction type"
              },
              {
                "name": "filter[accountNumber]",
                "value": "",
                "type": "query",
                "description": "Filter by account number"
              },
              {
                "name": "filter[feeID]",
                "value": "",
                "type": "query",
                "description": "Filter by fee ID"
              },
              {
                "name": "filter[transactionID]",
                "value": "",
                "type": "query",
                "description": "Filter by transaction ID"
              }
            ]
          },
          "docs": "Retrieve ledger entries that match the specified filters.\n### Permissions Required\n`Payment Read`"
        },
        {
          "info": {
            "name": "Get ledger entry",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.plce.opengov.com/plce/v2/:community/ledger-entries/:ledgerID",
            "params": [
              {
                "name": "ledgerID",
                "value": "",
                "type": "path",
                "description": "ID of a ledger"
              }
            ]
          },
          "docs": "Retrieve a ledger entry by ID.\n### Permissions Required\n`Payment Read`"
        }
      ]
    }
  ],
  "bundled": true
}