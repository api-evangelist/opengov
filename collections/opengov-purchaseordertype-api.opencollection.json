{
  "opencollection": "1.0.0",
  "info": {
    "name": "OpenGov Purchase Order Purchase Order Type API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "purchaseOrderType",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List PO types",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-purchase-order.procurement.opengov.com/api/v1/po/entities/:entityId/purchase-order-types"
          },
          "docs": "Returns the standard PO types (Standard, Blanket, Emergency). Per-entity overrides will be added in a later phase."
        }
      ]
    }
  ],
  "bundled": true
}