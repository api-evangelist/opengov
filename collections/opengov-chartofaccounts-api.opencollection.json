{
  "opencollection": "1.0.0",
  "info": {
    "name": "Budgeting & Performance Chart Of Accounts API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-KEY",
      "value": "{{X-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
