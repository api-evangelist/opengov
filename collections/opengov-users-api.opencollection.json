{
  "opencollection": "1.0.0",
  "info": {
    "name": "Permitting & Licensing Users API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.plce.opengov.com/plce/v2/:community/users",
            "params": [
              {
                "name": "filter[email]",
                "value": "",
                "type": "query",
                "description": "Filter by the email of a user"
              }
            ]
          },
          "docs": "Retrieve users in the community that match the specified filters.\n### Permissions Required\n`User Read`"
        },
        {
          "info": {
            "name": "Create a user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.plce.opengov.com/plce/v2/:community/users",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a user.\n### Permissions Required\n`User Write`"
        },
        {
          "info": {
            "name": "Retrieve a user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.plce.opengov.com/plce/v2/:community/users/:userID",
            "params": [
              {
                "name": "userID",
                "value": "",
                "type": "path",
                "description": "ID of the user"
              }
            ]
          },
          "docs": "Retrieve a user by ID.\n### Permissions Required\n`User Read`"
        }
      ]
    }
  ],
  "bundled": true
}