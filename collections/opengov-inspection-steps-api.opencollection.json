{
  "opencollection": "1.0.0",
  "info": {
    "name": "Permitting & Licensing Inspection Steps API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Inspection Steps",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List inspection steps",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.plce.opengov.com/plce/v2/:community/inspection-steps",
            "params": [
              {
                "name": "filter[assigneeID]",
                "value": "",
                "type": "query",
                "description": "Filter by the user ID of the record step assignee"
              },
              {
                "name": "filter[dueBy]",
                "value": "",
                "type": "query",
                "description": "Filter by date at which the record step is due"
              }
            ]
          },
          "docs": "Retrieve inspection steps that match the specified filters.\n### Permissions Required\n`Workflow Read`"
        },
        {
          "info": {
            "name": "Get inspection step",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.plce.opengov.com/plce/v2/:community/inspection-steps/:inspectionStepID",
            "params": [
              {
                "name": "inspectionStepID",
                "value": "",
                "type": "path",
                "description": "ID of an inspection step"
              }
            ]
          },
          "docs": "Retrieve an inspection step by ID.\n### Permissions Required\n`Workflow Read`"
        },
        {
          "info": {
            "name": "Update inspection step",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.plce.opengov.com/plce/v2/:community/inspection-steps/:inspectionStepID",
            "params": [
              {
                "name": "inspectionStepID",
                "value": "",
                "type": "path",
                "description": "ID of an inspection step"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an inspection step.\n### Permissions Required\n`Workflow Write`"
        }
      ]
    }
  ],
  "bundled": true
}